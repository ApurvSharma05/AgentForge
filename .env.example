# AgentForge Environment Configuration Example
# Copy this file to .env and insert your API keys:
# cp .env.example .env

# SerpAPI Key for Google search (get one at https://serpapi.com)
SERP_API_KEY=your_serpapi_key_here

# Groq API Key for Llama-3.3-70B inference (get one at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# System Configuration
LOG_LEVEL=INFO
SEARCH_TIMEOUT=15
SEARCH_MAX_RESULTS=10
